# Paramètres de la plateforme (générés par bin/install.sh, modifiables à la main).
# Lu par les scripts bin/*.sh et passé à docker compose (--env-file) pour l'interpolation.

# Rôle du serveur dans le parc (docs/09-parc-de-serveurs.md) :
#   all     : serveur unique (access, interface, PostgreSQL, bases) ;
#   control : serveur de contrôle (access + interface), aucune base ;
#   data    : serveur de bases (PostgreSQL + bases, nginx sans interface).
SERVER_ROLE=all
# Serveur de bases uniquement : URL du serveur de contrôle (interface + /access/graphql), accès SSH à ce serveur
# (enregistrement automatique des bases ; vide = commande affichée) et dossier deploy/ sur ce serveur.
CONTROL_URL=
CONTROL_SSH=
CONTROL_DEPLOY_DIR=/opt/toolso-emailing/deploy

# Hôte public de ce serveur (sans schéma) : interface et API (all), interface (control) ou API des bases (data).
# Les domaines de tracking sont par instance.
PUBLIC_HOST=emailing.exemple.com
# tls  : nginx écoute en 443 avec les certificats Let's Encrypt (/etc/letsencrypt/live/main), 80 redirige.
# plain: nginx écoute en 80 seulement (premier démarrage avant certificat, ou derrière un autre proxy TLS).
TLS_MODE=plain
# Schéma public (https en mode tls ou derrière un proxy TLS ; http sinon). Sert à PUBLIC_URL / API_PUBLIC_URL.
PUBLIC_SCHEME=https
# E-mail de l'administrateur : compte Let's Encrypt, superutilisateur access, administrateur par défaut des bases.
ADMIN_EMAIL=admin@exemple.com

# Mails de plateforme (invitations, réinitialisation, notifications d'export…).
SMTP_URL=smtp://user:pass@smtp.exemple.com:587
MAIL_FROM="Toolso Emailing <no-reply@exemple.com>"
SUPPORT_EMAIL=support@exemple.com

# Données persistantes (postgres/, files/<uid>/, letsencrypt/, certbot-www/).
TOOLSO_DATA_DIR=/var/lib/toolso-emailing
TZ=Europe/Paris

# Ports publiés par nginx sur l'hôte.
HTTP_PORT=80
HTTPS_PORT=443

# Dimensionnement PostgreSQL (serveur dédié partagé par plusieurs instances).
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=200
PG_MEM_LIMIT=2g

# Limites mémoire des conteneurs de la plateforme.
ACCESS_MEM_LIMIT=256m
NGINX_MEM_LIMIT=128m
# Image nginx d'un serveur de bases (rôle data).
NGINX_EDGE_IMAGE=nginx:1.27-alpine

# Seuils de bin/capacity.sh (serveur « plein » : ne plus y ajouter de base).
CAPACITY_MAX_DISK_PCT=60
CAPACITY_MAX_INSTANCES=25
CAPACITY_MAX_CONN_PCT=80
CAPACITY_MIN_CACHE_HIT_PCT=99
CAPACITY_MAX_LOAD_PER_CORE=0.7
CAPACITY_MIN_MEM_AVAILABLE_PCT=15

# Sauvegardes (bin/backup.sh).
BACKUP_DIR=/var/backups/toolso-emailing
BACKUP_KEEP_DAYS=14
# Destination rclone optionnelle (ex. s3:mon-bucket/toolso-emailing) : copie du jour après la sauvegarde locale.
BACKUP_RCLONE_REMOTE=

# Supervision (bin/monitor.sh, cron toutes les 5 min) : destinataire des alertes (défaut ADMIN_EMAIL) et seuils.
MONITOR_EMAIL=
# MONITOR_MAX_DISK_PCT=85
# MONITOR_MIN_MEM_PCT=5
# MONITOR_CERT_DAYS=14
# MONITOR_REMIND_HOURS=24
