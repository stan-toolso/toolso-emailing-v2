# Paramètres de la plateforme (générés par bin/install.sh, modifiables à la main).
# Lu par les scripts bin/*.sh et passé à docker compose (--env-file) pour l'interpolation.

# Hôte public de l'UI et des API (sans schéma). Les domaines de tracking sont par instance.
PUBLIC_HOST=emailing.exemple.com
# tls  : nginx écoute en 443 avec les certificats Let's Encrypt (/etc/letsencrypt/live/main), 80 redirige.
# plain: nginx écoute en 80 seulement (premier démarrage avant certificat, ou derrière un autre proxy TLS).
TLS_MODE=plain
# Schéma public (https en mode tls ou derrière un proxy TLS ; http sinon). Sert à PUBLIC_URL / API_PUBLIC_URL.
PUBLIC_SCHEME=https
# E-mail de l'administrateur : compte Let's Encrypt, superutilisateur access, administrateur par défaut des bases.
ADMIN_EMAIL=admin@exemple.com

# Mails de plateforme (invitations, réinitialisation, notifications d'export…).
SMTP_URL=smtp://user:pass@smtp.exemple.com:587
MAIL_FROM="Toolso Emailing <no-reply@exemple.com>"
SUPPORT_EMAIL=support@exemple.com

# Données persistantes (postgres/, files/<uid>/, letsencrypt/, certbot-www/).
TOOLSO_DATA_DIR=/var/lib/toolso-emailing
TZ=Europe/Paris

# Ports publiés par nginx sur l'hôte.
HTTP_PORT=80
HTTPS_PORT=443

# Dimensionnement PostgreSQL (serveur dédié partagé par plusieurs instances).
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=200
PG_MEM_LIMIT=2g

# Limites mémoire des conteneurs de la plateforme.
ACCESS_MEM_LIMIT=256m
NGINX_MEM_LIMIT=128m

# Sauvegardes (bin/backup.sh).
BACKUP_DIR=/var/backups/toolso-emailing
BACKUP_KEEP_DAYS=14
# Destination rclone optionnelle (ex. s3:mon-bucket/toolso-emailing) : copie du jour après la sauvegarde locale.
BACKUP_RCLONE_REMOTE=
