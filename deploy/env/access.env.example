# Environnement de l'access API (apps/access). Généré par bin/install.sh.
DATABASE_URL=postgres://access:changez-moi@postgres:5432/access
# Secret JWT partagé avec toutes les api d'instance (repris dans deploy/instances/<uid>/.env).
JWT_SECRET=changez-moi
SMTP_URL=smtp://user:pass@smtp.exemple.com:587
MAIL_FROM="Toolso Emailing <no-reply@exemple.com>"
PUBLIC_URL=https://emailing.exemple.com
LOG_LEVEL=INFO
