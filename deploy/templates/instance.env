# Instance « {{UID}} » : environnement de apps/api (rôles api, worker, scheduler).
# Généré par bin/add-database.sh le {{DATE}}. Ce fichier est à la fois l'env_file des conteneurs
# et la source d'interpolation de docker compose (limites mémoire *_MEM_LIMIT).

RESOURCE_UID={{UID}}
DATABASE_URL=postgres://emailing_{{UID}}:{{DB_PASSWORD}}@postgres:5432/emailing_{{UID}}
JWT_SECRET={{JWT_SECRET}}
PORT=4001

PUBLIC_URL={{PUBLIC_URL}}
API_PUBLIC_URL={{PUBLIC_URL}}/api/{{UID}}
FILES_DIR=/data/files
FILES_PUBLIC_URL={{PUBLIC_URL}}/files/{{UID}}
ACCESS_API_URL=http://access:4000/graphql

# Domaines de tracking (séparés par des virgules) servis par nginx vers cette api à la racine.
TRACKING_HOSTS={{TRACKING_HOSTS}}

SMTP_URL={{SMTP_URL}}
MAIL_FROM="{{MAIL_FROM}}"
SUPPORT_EMAIL={{SUPPORT_EMAIL}}

WORKER_CONCURRENCY=10
PG_POOL_MAX=10
LOG_LEVEL=INFO
TZ={{TZ}}

# Optionnel (voir docs/04-deploiement.md) :
# JOBS_DISABLED=
# SCHEDULES_FILE=
# COMPLAINT_SCORER_URL=
# USAGE_DATABASE_URL=
# GOOGLE_APPLICATION_CREDENTIALS=
# IP_API_KEY=
# RECAPTCHA_SECRET=

# Limites mémoire des conteneurs (interpolées par docker compose, ignorées par l'application).
API_MEM_LIMIT=384m
WORKER_MEM_LIMIT=512m
WORKER_HUGE_MEM_LIMIT=1g
SCHEDULER_MEM_LIMIT=384m
