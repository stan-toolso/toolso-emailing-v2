# Instance « {{UID}} » : environnement de apps/api (rôles api, worker, scheduler).
# Généré par bin/add-database.sh le {{DATE}}. Ce fichier est à la fois l'env_file des conteneurs
# et la source d'interpolation de docker compose (limites mémoire *_MEM_LIMIT).

RESOURCE_UID={{UID}}
DATABASE_URL=postgres://emailing_{{UID}}:{{DB_PASSWORD}}@postgres:5432/emailing_{{UID}}
JWT_SECRET={{JWT_SECRET}}
PORT=4001

# Interface (liens des mails) : ce serveur, ou le serveur de contrôle pour un serveur de bases.
PUBLIC_URL={{UI_URL}}
# API et fichiers de l'instance : toujours servis par ce serveur.
API_PUBLIC_URL={{API_BASE_URL}}/api/{{UID}}
FILES_DIR=/data/files
FILES_PUBLIC_URL={{API_BASE_URL}}/files/{{UID}}
ACCESS_API_URL={{ACCESS_API_URL}}

# Domaines de tracking (séparés par des virgules) servis par nginx vers cette api à la racine.
TRACKING_HOSTS={{TRACKING_HOSTS}}

SMTP_URL={{SMTP_URL}}
MAIL_FROM="{{MAIL_FROM}}"
SUPPORT_EMAIL={{SUPPORT_EMAIL}}

WORKER_CONCURRENCY=10
PG_POOL_MAX=10
LOG_LEVEL=INFO
TZ={{TZ}}

# Optionnel (voir docs/04-deploiement.md) :
# JOBS_DISABLED=
# SCHEDULES_FILE=
# COMPLAINT_SCORER_URL=
# USAGE_DATABASE_URL=
# GOOGLE_APPLICATION_CREDENTIALS=
# IP_API_KEY=
# RECAPTCHA_SECRET=
# API de transition toolso-media (/v1/…, voir docs/06 § API de transition) :
# MEDIA_PRODUCT_UIDS=         # uid des produits media servis (défaut : RESOURCE_UID)
# MEDIA_CONVERSION_URL=        # https://<api media>/v1/ad/click/conversion (conversions transférées à media)
# Transition depuis toolso-media : MEDIA_DATABASE_URL, MEDIA_PRODUCTS, ADS_DATABASE_URL (bin/set-media-source.sh),
# MEDIA_CAMPAIGNS_SCHEDULES=none (docs/06 § 7)
# Transition depuis toolso-media (docs/06) : job horaire sync_media_statuses (lit MEDIA_DATABASE_URL, MEDIA_PRODUCTS).
# MEDIA_STATUS_SYNC=1
# MEDIA_STATUS_SYNC_NEW_CONTACTS=0

# Limites mémoire des conteneurs (interpolées par docker compose, ignorées par l'application).
API_MEM_LIMIT=384m
WORKER_MEM_LIMIT=512m
WORKER_HUGE_MEM_LIMIT=1g
SCHEDULER_MEM_LIMIT=384m
