# Référence (à placer dans apps/ui/Dockerfile si l'application n'en fournit pas) :
# build CRA puis image nginx ; deploy/docker-compose.yml monte sa configuration par-dessus.
FROM node:22-alpine AS build
ARG REACT_APP_ACCESS_API_ENDPOINT=/access/graphql
ENV REACT_APP_ACCESS_API_ENDPOINT=$REACT_APP_ACCESS_API_ENDPOINT \
    NODE_OPTIONS=--openssl-legacy-provider \
    GENERATE_SOURCEMAP=false
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80 443
