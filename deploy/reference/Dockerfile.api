# Référence (à placer dans apps/api/Dockerfile si l'application n'en fournit pas) :
# image Node 22, un process par rôle (ROLE=api|worker|scheduler|all), GET /health en api.
FROM node:22-alpine
ENV NODE_ENV=production TZ=Europe/Paris
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY . .
RUN mkdir -p /data/files && chown -R node:node /data /app
USER node
EXPOSE 4001
CMD ["node", "src/main.js"]
