# Access API — instance autonome. Copier en .env (jamais commité).

# Connexion PostgreSQL de la base access (obligatoire)
DATABASE_URL=postgres://access:access@postgres:5432/access
# PGSSL=true pour exiger SSL sur la connexion (certificat non vérifié)
#PGSSL=false

# Port d'écoute HTTP (défaut 4000) ; le process écoute sur 0.0.0.0
PORT=4000

# Secret de signature des JWT (HS256, 7 jours) : même valeur que les API emailing de l'instance (obligatoire)
JWT_SECRET=change-me

# Hôte public de l'UI, sans slash final : liens des mails (/#/resetpassword/<token>, /#/join/<token>) et logo (obligatoire)
PUBLIC_URL=https://emailing.exemple.com

# Mails de plateforme (réinitialisation de mot de passe, invitation). Sans SMTP_URL, les mails sont journalisés au lieu d'être envoyés.
#SMTP_URL=smtp://user:pass@smtp.exemple.com:587
#MAIL_FROM="Toolso" <no-reply@exemple.com>

# Niveau de log log4js : ALL, TRACE, DEBUG, INFO (défaut), WARN, ERROR, FATAL, OFF
LOG_LEVEL=INFO
