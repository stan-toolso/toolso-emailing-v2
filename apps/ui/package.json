  "scripts": {
    "start": "react-scripts start",
    "local": "REACT_APP_API_ENDPOINT=http://localhost:4001 react-scripts start",
    "local-access": "REACT_APP_ACCESS_API_ENDPOINT=http://localhost:4000/graphql react-scripts start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "bdd": "cucumber-js",
    "test": "react-scripts test --transformIgnorePatterns \"node_modules/(?!your-module-name)/\"",
    "test:cov": "npm test -- --coverage --watchAll=false",
    "test:debug": "react-scripts --inspect-brk test --runInBand",
