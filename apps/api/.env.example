# ---- Instance (une base emailing par instance) ---------------------------------------------
RESOURCE_UID=exemple
ROLE=all                      # api | worker | scheduler | all
PORT=4001
LOG_LEVEL=INFO

# ---- PostgreSQL ------------------------------------------------------------------------------
DATABASE_URL=postgres://emailing:motdepasse@postgres:5432/emailing_exemple
# PGSSL=true
# PG_POOL_MAX=10

# ---- Sécurité (partagé avec l'access API ; à reprendre du secret jwt_secret lors d'une migration) --
JWT_SECRET=changez-moi

# ---- URL publiques ---------------------------------------------------------------------------
PUBLIC_URL=https://emailing.exemple.com
API_PUBLIC_URL=https://emailing.exemple.com/api/exemple
FILES_DIR=/data/files
FILES_PUBLIC_URL=https://emailing.exemple.com/files/exemple
ACCESS_API_URL=http://access:4000/graphql

# ---- Mails de la plateforme (alertes, BAT, exports) -------------------------------------------
SMTP_URL=smtp://utilisateur:motdepasse@smtp.exemple.com:587
MAIL_FROM="Toolso Emailing" <no-reply@emailing.exemple.com>
SUPPORT_EMAIL=support@exemple.com

# ---- Worker / scheduler ----------------------------------------------------------------------
# WORKER_QUEUE=default         # default | huge
# WORKER_CONCURRENCY=10
# SCHEDULES_FILE=/config/schedules.json
# JOBS_DISABLED=calculate_usages,update_adsense_incomes_today
# CRON_TZ=UTC

# ---- Services optionnels ---------------------------------------------------------------------
# COMPLAINT_SCORER_URL=https://scorer.exemple.com/score
# USAGE_DATABASE_URL=postgres://.../toolso_usage
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-analytics.json
# IP_API_KEY=                  # protection des clics (pro.ip-api.com)
# RECAPTCHA_SECRET=            # validation des clics suspects
# RECAPTCHA_SITE_KEY=
# CLICK_VALIDATION_HOST=https://lk.exemple.com
